# Project Chimera deterministic runtime in Flow 2.x.
# No network, model training, or external tool execution is implied.
# All retained strings are privately owned by the runtime until replaced/shutdown.

extern {
    function calloc(count: i64, width: i64) -> ptr<void>
    function free(memory: ptr<void>) -> void
    function strlen(value: string) -> i64
    function strcpy(dest: ptr<u8>, src: ptr<u8>) -> ptr<u8>
    function strcmp(a: string, b: string) -> i32
    function strstr(haystack: ptr<u8>, needle: ptr<u8>) -> ptr<u8>
    function sqrt(value: f64) -> f64
}

const WORK_CAP: i32 = 20
const EPISODE_CAP: i32 = 64
const STATE_CAP: i32 = 32
const VECTOR_DIM: i32 = 8

struct Experience {
    observation: string,
    action: string,
    outcome: string
}

struct VectorMatch {
    observation: string,
    action: string,
    outcome: string,
    similarity: f64
}

struct CognitiveSnapshot {
    decision: string,
    confidence: f64,
    processing_load: f64,
    focus: f64
}

struct ToolResult {
    success: bool,
    should_exit: bool,
    output: string,
    number: i32
}

let mut ready: bool = false

let mut work_records: ptr<string> = null
let mut work_next: i32 = 0
let mut work_size: i32 = 0

let mut episode_observations: ptr<string> = null
let mut episode_actions: ptr<string> = null
let mut episode_outcomes: ptr<string> = null
let mut episode_vectors: ptr<f64> = null
let mut episode_vector_valid: ptr<i32> = null
let mut episode_next: i32 = 0
let mut episode_size: i32 = 0

let mut state_decisions: ptr<string> = null
let mut state_confidences: ptr<f64> = null
let mut state_loads: ptr<f64> = null
let mut state_focus: ptr<f64> = null
let mut state_next: i32 = 0
let mut state_size: i32 = 0
let mut total_steps: i32 = 0
let mut monitoring_enabled: bool = true
let mut reflection_frequency: i32 = 5

function owned_copy(value: string) -> string {
    let count: i64 = strlen(value) + 1
    let dest: ptr<u8> = calloc(count, 1) as ptr<u8>
    if dest == null {
        return null
    }
    strcpy(dest, value as ptr<u8>)
    return dest as string
}

function dispose_owned(value: string) -> void {
    if value != null {
        free(value as ptr<void>)
    }
}

export function chimera_shutdown() -> void {
    if work_records != null {
        for i in 0 to WORK_CAP {
            dispose_owned(work_records[i])
        }
        free(work_records as ptr<void>)
    }
    if episode_observations != null {
        for i in 0 to EPISODE_CAP {
            dispose_owned(episode_observations[i])
        }
        free(episode_observations as ptr<void>)
    }
    if episode_actions != null {
        for i in 0 to EPISODE_CAP {
            dispose_owned(episode_actions[i])
        }
        free(episode_actions as ptr<void>)
    }
    if episode_outcomes != null {
        for i in 0 to EPISODE_CAP {
            dispose_owned(episode_outcomes[i])
        }
        free(episode_outcomes as ptr<void>)
    }
    if episode_vectors != null { free(episode_vectors as ptr<void>) }
    if episode_vector_valid != null { free(episode_vector_valid as ptr<void>) }
    if state_decisions != null {
        for i in 0 to STATE_CAP {
            dispose_owned(state_decisions[i])
        }
        free(state_decisions as ptr<void>)
    }
    if state_confidences != null { free(state_confidences as ptr<void>) }
    if state_loads != null { free(state_loads as ptr<void>) }
    if state_focus != null { free(state_focus as ptr<void>) }
    work_records = null
    episode_vectors = null
    episode_vector_valid = null
    episode_observations = null
    episode_actions = null
    episode_outcomes = null
    state_decisions = null
    state_confidences = null
    state_loads = null
    state_focus = null
    work_next = 0
    work_size = 0
    episode_next = 0
    episode_size = 0
    state_next = 0
    state_size = 0
    total_steps = 0
    monitoring_enabled = true
    reflection_frequency = 5
    ready = false
}

# Tier-1 Flow targets are 64-bit, so C pointers occupy eight bytes.
export function chimera_init() -> bool {
    chimera_shutdown()
    work_records = calloc(WORK_CAP as i64, 8) as ptr<string>
    episode_observations = calloc(EPISODE_CAP as i64, 8) as ptr<string>
    episode_actions = calloc(EPISODE_CAP as i64, 8) as ptr<string>
    episode_outcomes = calloc(EPISODE_CAP as i64, 8) as ptr<string>
    episode_vectors = calloc((EPISODE_CAP * VECTOR_DIM) as i64, 8) as ptr<f64>
    episode_vector_valid = calloc(EPISODE_CAP as i64, 4) as ptr<i32>
    state_decisions = calloc(STATE_CAP as i64, 8) as ptr<string>
    state_confidences = calloc(STATE_CAP as i64, 8) as ptr<f64>
    state_loads = calloc(STATE_CAP as i64, 8) as ptr<f64>
    state_focus = calloc(STATE_CAP as i64, 8) as ptr<f64>
    if work_records == null or episode_observations == null or episode_actions == null or episode_outcomes == null or episode_vectors == null or episode_vector_valid == null or state_decisions == null or state_confidences == null or state_loads == null or state_focus == null {
        chimera_shutdown()
        return false
    }
    ready = true
    return true
}

export function chimera_is_ready() -> bool {
    return ready
}

export function chimera_work_size() -> i32 {
    return work_size
}

export function chimera_work_clear() -> void {
    if !ready { return }
    for i in 0 to WORK_CAP {
        dispose_owned(work_records[i])
        work_records[i] = null
    }
    work_next = 0
    work_size = 0
}

export function chimera_work_add(record: string) -> bool {
    if !ready { return false }
    let copy: string = owned_copy(record)
    if copy == null { return false }
    dispose_owned(work_records[work_next])
    work_records[work_next] = copy
    work_next = (work_next + 1) % WORK_CAP
    if work_size < WORK_CAP { work_size = work_size + 1 }
    return true
}

# Chronological access: 0 is the oldest retained record.
# Returned strings are borrowed; callers must not hold them after a mutation.
export function chimera_work_get(index: i32) -> string {
    if !ready or index < 0 or index >= work_size { return "" }
    let physical: i32 = (work_next - work_size + index + WORK_CAP) % WORK_CAP
    return work_records[physical]
}

export function chimera_episode_clear() -> void {
    if !ready { return }
    for i in 0 to EPISODE_CAP {
        dispose_owned(episode_observations[i])
        dispose_owned(episode_actions[i])
        dispose_owned(episode_outcomes[i])
        episode_observations[i] = null
        episode_actions[i] = null
        episode_outcomes[i] = null
        episode_vector_valid[i] = 0
    }
    episode_next = 0
    episode_size = 0
}

# Oldest retained episode is index zero. Strings are borrowed until mutation.
export function chimera_episode_get(index: i32) -> Experience {
    if !ready or index < 0 or index >= episode_size {
        return Experience { observation: "", action: "", outcome: "" }
    }
    let physical: i32 = (episode_next - episode_size + index + EPISODE_CAP) % EPISODE_CAP
    return Experience { observation: episode_observations[physical], action: episode_actions[physical], outcome: episode_outcomes[physical] }
}

export function chimera_episode_size() -> i32 {
    return episode_size
}

export function chimera_remember(observation: string, action: string, outcome: string) -> bool {
    if !ready { return false }
    let a: string = owned_copy(observation)
    let b: string = owned_copy(action)
    let c: string = owned_copy(outcome)
    if a == null or b == null or c == null {
        dispose_owned(a)
        dispose_owned(b)
        dispose_owned(c)
        return false
    }
    dispose_owned(episode_observations[episode_next])
    dispose_owned(episode_actions[episode_next])
    dispose_owned(episode_outcomes[episode_next])
    episode_observations[episode_next] = a
    episode_actions[episode_next] = b
    episode_outcomes[episode_next] = c
    episode_vector_valid[episode_next] = 0
    episode_next = (episode_next + 1) % EPISODE_CAP
    if episode_size < EPISODE_CAP { episode_size = episode_size + 1 }
    return true
}

# Store an embedding alongside an episode. Embeddings come from a caller-owned
# model; this runtime does not pretend to generate semantic embeddings.
# Exactly eight finite components are required.
export function chimera_remember_vector(observation: string, action: string, outcome: string, vector: ptr<f64>, dimensions: i32) -> bool {
    if !ready or vector == null or dimensions != VECTOR_DIM { return false }
    let mut norm: f64 = 0.0
    for i in 0 to VECTOR_DIM {
        let value: f64 = vector[i]
        if value != value or value > 1.0e100 or value < -1.0e100 { return false }
        norm = norm + value * value
    }
    if norm <= 0.0 { return false }
    if !chimera_remember(observation, action, outcome) { return false }
    let physical: i32 = (episode_next - 1 + EPISODE_CAP) % EPISODE_CAP
    for i in 0 to VECTOR_DIM {
        episode_vectors[physical * VECTOR_DIM + i] = vector[i]
    }
    episode_vector_valid[physical] = 1
    return true
}

function vector_similarity(query: ptr<f64>, physical: i32, query_norm: f64) -> f64 {
    let mut dot: f64 = 0.0
    let mut norm: f64 = 0.0
    for i in 0 to VECTOR_DIM {
        let x: f64 = episode_vectors[physical * VECTOR_DIM + i]
        dot = dot + query[i] * x
        norm = norm + x * x
    }
    if norm <= 0.0 { return -2.0 }
    return dot / sqrt(query_norm * norm)
}

# Ranked cosine retrieval, newest wins an exact similarity tie.
# Empty result has similarity -2, distinct from a valid -1 cosine score.
export function chimera_recall_vector(query: ptr<f64>, dimensions: i32, match_rank: i32) -> VectorMatch {
    let empty: VectorMatch = VectorMatch { observation: "", action: "", outcome: "", similarity: -2.0 }
    if !ready or query == null or dimensions != VECTOR_DIM or match_rank < 0 { return empty }
    let mut query_norm: f64 = 0.0
    for i in 0 to VECTOR_DIM {
        let x: f64 = query[i]
        if x != x or x > 1.0e100 or x < -1.0e100 { return empty }
        query_norm = query_norm + x * x
    }
    if query_norm <= 0.0 { return empty }
    for offset in 0 to episode_size {
        let physical: i32 = (episode_next - 1 - offset + EPISODE_CAP) % EPISODE_CAP
        if episode_vector_valid[physical] != 0 {
            let score: f64 = vector_similarity(query, physical, query_norm)
            let mut preceding: i32 = 0
            for other in 0 to episode_size {
                let other_physical: i32 = (episode_next - 1 - other + EPISODE_CAP) % EPISODE_CAP
                if episode_vector_valid[other_physical] != 0 {
                    let other_score: f64 = vector_similarity(query, other_physical, query_norm)
                    if other_score > score or (other_score == score and other < offset) {
                        preceding = preceding + 1
                    }
                }
            }
            if preceding == match_rank {
                return VectorMatch {
                    observation: episode_observations[physical],
                    action: episode_actions[physical],
                    outcome: episode_outcomes[physical],
                    similarity: score
                }
            }
        }
    }
    return empty
}

function contains_text(haystack: string, needle: string) -> bool {
    if strcmp(needle, "") == 0 { return false }
    return strstr(haystack as ptr<u8>, needle as ptr<u8>) != null
}

# Deterministic lexical search, newest first. No embedding semantics.
# match_rank=0 gives the newest match; -1/absent returns an empty tuple.
export function chimera_recall_at(query: string, match_rank: i32) -> Experience {
    let empty: Experience = Experience { observation: "", action: "", outcome: "" }
    if !ready or match_rank < 0 or strcmp(query, "") == 0 { return empty }
    let mut matches: i32 = 0
    for offset in 0 to episode_size {
        let index: i32 = (episode_next - 1 - offset + EPISODE_CAP) % EPISODE_CAP
        if contains_text(episode_observations[index], query) or contains_text(episode_actions[index], query) or contains_text(episode_outcomes[index], query) {
            if matches == match_rank {
                return Experience {
                    observation: episode_observations[index],
                    action: episode_actions[index],
                    outcome: episode_outcomes[index]
                }
            }
            matches = matches + 1
        }
    }
    return empty
}

export function chimera_state_get(index: i32) -> CognitiveSnapshot {
    if !ready or index < 0 or index >= state_size {
        return CognitiveSnapshot { decision: "", confidence: 0.0, processing_load: 0.0, focus: 0.0 }
    }
    let physical: i32 = (state_next - state_size + index + STATE_CAP) % STATE_CAP
    return CognitiveSnapshot {
        decision: state_decisions[physical],
        confidence: state_confidences[physical],
        processing_load: state_loads[physical],
        focus: state_focus[physical]
    }
}

export function chimera_monitor_enable(enabled: bool) -> void {
    monitoring_enabled = enabled
}

export function chimera_set_reflection_frequency(frequency: i32) -> bool {
    if frequency <= 0 { return false }
    reflection_frequency = frequency
    return true
}

export function chimera_reflection_due() -> bool {
    return ready and monitoring_enabled and total_steps > 0 and total_steps % reflection_frequency == 0
}

export function chimera_state_size() -> i32 {
    return state_size
}

export function chimera_record_state(decision: string, confidence: f64, processing_load: f64, focus: f64) -> bool {
    if !ready { return false }
    if confidence != confidence or processing_load != processing_load or focus != focus or confidence < 0.0 or confidence > 1.0 or processing_load < 0.0 or processing_load > 1.0 or focus < 0.0 or focus > 1.0 {
        return false
    }
    let copy: string = owned_copy(decision)
    if copy == null { return false }
    dispose_owned(state_decisions[state_next])
    state_decisions[state_next] = copy
    state_confidences[state_next] = confidence
    state_loads[state_next] = processing_load
    state_focus[state_next] = focus
    state_next = (state_next + 1) % STATE_CAP
    if state_size < STATE_CAP { state_size = state_size + 1 }
    return true
}

export function chimera_avg_confidence() -> f64 {
    if state_size == 0 { return 0.0 }
    let mut sum: f64 = 0.0
    for i in 0 to state_size {
        sum = sum + state_confidences[i]
    }
    return sum / (state_size as f64)
}

export function chimera_avg_focus() -> f64 {
    if state_size == 0 { return 0.0 }
    let mut sum: f64 = 0.0
    for i in 0 to state_size {
        sum = sum + state_focus[i]
    }
    return sum / (state_size as f64)
}

# From upstream Narcissus: compare against historical average with +/- 0.1.
# 0 baseline/within range, 1 higher, -1 lower.
export function chimera_confidence_relation(current: f64) -> i32 {
    if state_size == 0 { return 0 }
    let average: f64 = chimera_avg_confidence()
    if current > average + 0.1 { return 1 }
    if current < average - 0.1 { return -1 }
    return 0
}

export function chimera_focus_deviated() -> bool {
    if state_size < 2 { return false }
    let last: i32 = (state_next - 1 + STATE_CAP) % STATE_CAP
    let diff: f64 = state_focus[last] - chimera_avg_focus()
    return diff > 0.2 or diff < -0.2
}

# The upstream threshold: 5 most recent load scores average above 0.8.
export function chimera_load_warning() -> bool {
    if state_size < 6 { return false }
    let mut sum: f64 = 0.0
    for offset in 0 to 5 {
        let index: i32 = (state_next - 1 - offset + STATE_CAP) % STATE_CAP
        sum = sum + state_loads[index]
    }
    return sum / 5.0 > 0.8
}

# Repeated decisions are a heuristic, not proof of confirmation bias.
export function chimera_repeated_decision() -> bool {
    if state_size < 4 { return false }
    let a: i32 = (state_next - 1 + STATE_CAP) % STATE_CAP
    let b: i32 = (state_next - 2 + STATE_CAP) % STATE_CAP
    let c: i32 = (state_next - 3 + STATE_CAP) % STATE_CAP
    if strcmp(state_decisions[a], "none") == 0 { return false }
    return strcmp(state_decisions[a], state_decisions[b]) == 0 and strcmp(state_decisions[b], state_decisions[c]) == 0
}

# Preference oracle: ranks supplied model scores, not a trained reward model.
# First candidate wins ties. Invalid input returns -1.
export function chimera_best_candidate(scores: ptr<f64>, count: i32) -> i32 {
    if scores == null or count <= 0 { return -1 }
    let mut best: i32 = 0
    let mut i: i32 = 1
    while i < count {
        if scores[i] > scores[best] {
            best = i
        }
        i = i + 1
    }
    return best
}

# A small allowlisted tool registry. Arbitrary commands/files/network are denied.
export function chimera_act(tool: string, payload: string, a: i32, b: i32) -> ToolResult {
    if strcmp(tool, "echo") == 0 {
        return ToolResult { success: true, should_exit: false, output: payload, number: 0 }
    }
    if strcmp(tool, "sum_numbers") == 0 {
        return ToolResult { success: true, should_exit: false, output: "sum", number: a + b }
    }
    if strcmp(tool, "exit") == 0 {
        return ToolResult { success: true, should_exit: true, output: "stopped", number: 0 }
    }
    return ToolResult { success: false, should_exit: false, output: "tool_not_registered", number: 0 }
}

# One bounded perceive -> act -> remember -> introspect step.
# An external model/provider must choose the action; this function never calls one.
export function chimera_step(observation: string, action: string, payload: string, a: i32, b: i32, confidence: f64, load: f64, focus: f64) -> ToolResult {
    if !ready {
        return ToolResult { success: false, should_exit: false, output: "runtime_not_initialized", number: 0 }
    }
    if confidence != confidence or load != load or focus != focus or confidence < 0.0 or confidence > 1.0 or load < 0.0 or load > 1.0 or focus < 0.0 or focus > 1.0 {
        return ToolResult { success: false, should_exit: false, output: "invalid_cognitive_state", number: 0 }
    }
    let outcome: ToolResult = chimera_act(action, payload, a, b)
    if !chimera_remember(observation, action, outcome.output) {
        return ToolResult { success: false, should_exit: false, output: "episodic_storage_failed", number: 0 }
    }
    chimera_work_add(observation)
    chimera_work_add(action)
    chimera_work_add(outcome.output)
    chimera_record_state(action, confidence, load, focus)
    total_steps = total_steps + 1
    return outcome
}

export function chimera_steps() -> i32 {
    return total_steps
}
