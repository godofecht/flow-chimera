import "src/chimera.flow"

extern {
    function strcmp(a: string, b: string) -> i32
}

function same(a: string, b: string) -> bool {
    return strcmp(a, b) == 0
}

function check_working_memory() -> i32 {
    chimera_work_clear()
    if chimera_work_size() != 0 { return 1 }
    if !chimera_work_add("old") { return 2 }
    if !same(chimera_work_get(0), "old") { return 3 }
    for i in 0 to 20 {
        if !chimera_work_add("new") { return 4 }
    }
    if chimera_work_size() != 20 { return 5 }
    if !same(chimera_work_get(0), "new") { return 6 }
    if !same(chimera_work_get(19), "new") { return 7 }
    if !same(chimera_work_get(-1), "") { return 8 }
    if !same(chimera_work_get(20), "") { return 9 }
    chimera_work_clear()
    if chimera_work_size() != 0 { return 10 }
    return 0
}

function check_episodes() -> i32 {
    if !chimera_remember("blue elephant", "observe", "confirmed") { return 1 }
    if !chimera_remember("the moon", "inspect", "quiet") { return 2 }
    let recalled: Experience = chimera_recall_at("elephant", 0)
    if !same(recalled.observation, "blue elephant") { return 3 }
    if !same(recalled.action, "observe") { return 4 }
    if !same(recalled.outcome, "confirmed") { return 5 }
    if !same(chimera_recall_at("missing", 0).observation, "") { return 6 }
    if !same(chimera_recall_at("", 0).observation, "") { return 7 }
    if !chimera_remember("blue again", "observe", "second") { return 8 }
    if !same(chimera_recall_at("blue", 0).observation, "blue again") { return 9 }
    if !same(chimera_recall_at("blue", 1).observation, "blue elephant") { return 10 }
    if !same(chimera_recall_at("blue", 2).observation, "") { return 11 }
    return 0
}

function check_oracle() -> i32 {
    let mut scores: array<f64, 4> = [0.2, 0.9, 0.9, -1.0]
    if chimera_best_candidate(&scores[0], 4) != 1 { return 1 }
    if chimera_best_candidate(null, 4) != -1 { return 2 }
    if chimera_best_candidate(&scores[0], 0) != -1 { return 3 }
    return 0
}

function check_metacognition() -> i32 {
    if !chimera_record_state("inspect", 0.4, 0.9, 0.1) { return 1 }
    if !chimera_record_state("inspect", 0.4, 0.9, 0.1) { return 2 }
    if !chimera_record_state("inspect", 0.4, 0.9, 0.1) { return 3 }
    if !chimera_record_state("inspect", 0.4, 0.9, 0.1) { return 4 }
    if !chimera_record_state("inspect", 0.4, 0.9, 0.1) { return 5 }
    if !chimera_record_state("inspect", 0.4, 0.9, 0.9) { return 6 }
    if chimera_state_size() != 6 { return 7 }
    if !chimera_load_warning() { return 8 }
    if !chimera_repeated_decision() { return 9 }
    if !chimera_focus_deviated() { return 10 }
    if chimera_confidence_relation(0.8) != 1 { return 11 }
    if chimera_confidence_relation(0.1) != -1 { return 12 }
    if chimera_confidence_relation(0.4) != 0 { return 13 }
    if chimera_record_state("invalid", 1.5, 0.2, 0.3) { return 14 }
    if chimera_state_size() != 6 { return 15 }
    return 0
}

function check_agent() -> i32 {
    let result: ToolResult = chimera_step("calculate", "sum_numbers", "", 5, 10, 0.6, 0.2, 0.7)
    if !result.success or result.should_exit or result.number != 15 { return 1 }
    if chimera_steps() != 1 { return 2 }
    if !same(chimera_recall_at("calculate", 0).action, "sum_numbers") { return 3 }
    let denied: ToolResult = chimera_step("unsafe", "shell", "rm -rf /", 0, 0, 0.4, 0.2, 0.4)
    if denied.success or !same(denied.output, "tool_not_registered") { return 4 }
    let rejected: ToolResult = chimera_step("invalid", "echo", "oops", 0, 0, 2.0, 0.2, 0.2)
    if rejected.success or chimera_steps() != 2 { return 5 }
    let echoed: ToolResult = chimera_step("greeting", "echo", "hello", 0, 0, 0.4, 0.2, 0.2)
    if !echoed.success or !same(echoed.output, "hello") { return 6 }
    let stopped: ToolResult = chimera_step("done", "exit", "", 0, 0, 0.5, 0.1, 0.3)
    if !stopped.success or !stopped.should_exit { return 7 }
    if chimera_steps() != 4 { return 8 }
    return 0
}

function main() -> i32 {
    if !chimera_init() { return 1 }
    let a: i32 = check_working_memory()
    if a != 0 { print("working failed: "); println(a); return 10 + a }
    let b: i32 = check_episodes()
    if b != 0 { print("episodes failed: "); println(b); return 30 + b }
    let c: i32 = check_oracle()
    if c != 0 { print("oracle failed: "); println(c); return 50 + c }
    let d: i32 = check_metacognition()
    if d != 0 { print("metacognition failed: "); println(d); return 70 + d }
    let e: i32 = check_agent()
    if e != 0 { print("agent failed: "); println(e); return 90 + e }
    chimera_shutdown()
    if chimera_work_size() != 0 { return 120 }
    if !chimera_init() { return 121 }
    chimera_shutdown()
    println("PASS: Flow Chimera deterministic runtime")
    return 0
}
